---
import { site, nav, socials, features } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__col">
      <p class="site-footer__name">{site.name}</p>
      <p class="site-footer__tagline">{site.tagline}</p>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Pages</h2>
      <ul class="site-footer__list">
        <li><a href="/">Home</a></li>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Elsewhere</h2>
      <ul class="site-footer__list">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
        {features.blog && (
          <li>
            <a href="/rss.xml">RSS</a>
          </li>
        )}
      </ul>
    </div>
  </div>

  <div class="wrap site-footer__bottom">
    <p>© {year} {site.name}</p>
    <p class="site-footer__colophon">
      Built with <a href="https://astro.build" rel="noopener" target="_blank">Astro</a>, hosted on{" "}
      <a href="https://netlify.com" rel="noopener" target="_blank">Netlify</a>. No trackers.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-2xl);
    border-block-start: 1px solid var(--border);
    background: var(--bg-sunken);
    padding-block-start: var(--space-xl);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-l);
    padding-block-end: var(--space-xl);
  }

  @media (min-width: 40rem) {
    .site-footer__inner {
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: var(--space-m);
    }
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 660;
    letter-spacing: -0.03em;
  }

  .site-footer__tagline {
    color: var(--text-muted);
    font-size: var(--step--1);
    max-width: 30ch;
    margin-block-start: var(--space-2xs);
  }

  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-block-end: var(--space-xs);
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: var(--step--1);
  }

  .site-footer__list a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .site-footer__list a:hover {
    color: var(--accent);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-block: var(--space-s);
    border-block-start: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .site-footer__colophon a {
    color: var(--text-muted);
  }
</style>
